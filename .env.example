# See docs/CONFIGURATION-STANDARD.md and deploy/*.env.example for Production.
# Documentation only: ASP.NET does not load .env automatically.
# Set these in the shell or hosting secret store. No credentials in this file.
ASPNETCORE_ENVIRONMENT=Development
DATABASE__PROVIDER=SqlServer
CONNECTIONSTRINGS__MYCNN=
JWTSETTINGS__KEY=
JWTSETTINGS__ISSUER=NoteTatCa
JWTSETTINGS__AUDIENCE=NoteTatCa.Web
JWTSETTINGS__EXPIRATIONMINUTES=15
CORS__ALLOWEDORIGINS__0=http://localhost:5173
CORS__ALLOWEDORIGINS__1=https://localhost:5037
AUTHENTICATION__GOOGLE__ENABLED=false
AUTHENTICATION__GOOGLE__CLIENTID=
# API validates Google ID tokens; Google ClientSecret stays only in legacy Razor when used.
SMTPSETTINGS__HOST=
SMTPSETTINGS__PORT=587
SMTPSETTINGS__FROMEMAIL=
SMTPSETTINGS__PASSWORD=
SMTPSETTINGS__ENABLESSL=true
APPSETTINGS__CLIENTURL=http://localhost:5173
BACKGROUNDJOBS__ENABLED=false
SWAGGER__ENABLED=false
RATELIMITING__AUTHREQUESTSPERMINUTE=20
RATELIMITING__APIREQUESTSPERMINUTE=600
# Persist Identity data-protection keys securely for reset/change-email tokens across restarts.
DATAPROTECTION__KEYSDIRECTORY=
# Used only with the explicit --grant-admin operation, after registration/verification.
BOOTSTRAP__ADMINEMAIL=
