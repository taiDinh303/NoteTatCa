# Safe defaults are in appsettings.Production.json; values below vary by deployment.
ASPNETCORE_ENVIRONMENT=Production
DATABASE__PROVIDER=PostgreSQL
CONNECTIONSTRINGS__MYCNN=
JWTSETTINGS__KEY=
CORS__ALLOWEDORIGINS__0=https://note-tat-ca.vercel.app
APPSETTINGS__CLIENTURL=https://note-tat-ca.vercel.app
# JWT issuer/audience/TTL, Swagger and seed flags come from safe Production JSON.
# Optional overrides: SMTP/Google and DataProtection settings.
# Render Free blocks SMTP ports. To use HTTPS email, add these only after verification:
# EMAIL__PROVIDER=Brevo
# EMAIL__FROMEMAIL=sender@example.test
# EMAIL__FROMNAME=NoteTatCa
# EMAIL__BREVO__APIKEY=<set directly in Render; never commit a real key>
BACKGROUNDJOBS__ENABLED=true
SUPABASE__URL=https://nxqupzwqawujtgeuvvcj.supabase.co
# Reserved for future note attachments. Fill with the NTC backend key, never a placeholder.
SUPABASE__SERVICE_KEY=
# Optional paid mascot AI. Keep disabled until the additive queue migration is reviewed/applied.
# MASCOTAI__ENABLED=true
# MASCOTAI__MODEL=gpt-image-2.5-flare
# MASCOTAI__OPENAIAPIKEY=<set only in Render or API User Secrets; never in VITE_ variables>
