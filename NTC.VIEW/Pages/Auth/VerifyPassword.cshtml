@page "/auth/verify-password"
@model NTC.Razor.Pages.Auth.VerifyPasswordModel

@{
    ViewData["Title"] = "Verify Password";
}

<div class="settings-page">

    <div class="settings-card">

        <div class="settings-card-header">
            Verify Password
        </div>

        <div class="settings-card-body">

            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="settings-alert settings-alert-danger">
                    @ViewData["ErrorMessage"]
                </div>
            }

            <form method="post">

                <div class="password-group">

                    <label for="passwordInput"
                           class="settings-label">
                        Password
                    </label>

                    <div class="password-wrapper">
                        <input type="password"
                               id="passwordInput"
                               name="Password"
                               class="settings-input"
                               placeholder="Enter your password"
                               required />

                        <button type="button"
                                id="togglePassword"
                                class="password-toggle">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                </div>

                <button type="submit"
                        class="settings-btn settings-btn-submit">
                    Verify
                </button>

                <a href="/settings/account"
                   class="settings-btn settings-btn-cancel">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Styles {

    <link rel="stylesheet"
          href="~/css/setting_edit.css"
          asp-append-version="true" />

}

@section Scripts {

    <script>

        const toggleBtn =
            document.getElementById("togglePassword");

        const passwordInput =
            document.getElementById("passwordInput");

        toggleBtn.addEventListener("click", () => {

            const isPassword =
                passwordInput.type === "password";

            passwordInput.type =
                isPassword ? "text" : "password";

            toggleBtn.innerHTML =
                isPassword
                    ? '<i class="bi bi-eye-slash"></i>'
                    : '<i class="bi bi-eye"></i>';

        });

    </script>

}