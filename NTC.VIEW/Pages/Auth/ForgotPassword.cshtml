@page "/auth/forgotpassword"
@model NTC.Razor.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="login-register-page">

    <div class="login-card">

        <h2 class="login-title">Forgot Password</h2>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        @if (Model.SuccessMessage != null)
        {
            <div class="alert-success">@Model.SuccessMessage</div>
        }

        <form method="post">

            <div class="form-group">
                <label for="Email">Email</label>
                <input asp-for="Email" id="Email" type="email" required />
            </div>

            <button type="submit" class="btn-primary">
                Send Reset Link
            </button>

            <div class="register-link">
                <a href="/auth/login">
                    Back to <strong>Login</strong>
                </a>
            </div>

        </form>

    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

