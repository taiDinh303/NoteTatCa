@page "/auth/forgotpassword"
@model NTC.Razor.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-4 d-flex justify-content-center">
    <div class="card shadow-sm p-4" style="width: 400px;">
        <h3 class="text-center text-primary mb-3">Forgot Password</h3>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger text-center">@Model.ErrorMessage</div>
        }

        @if (Model.SuccessMessage != null)
        {
            <div class="alert alert-success text-center">@Model.SuccessMessage</div>
        }

        <form method="post">
            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" placeholder="Email" required />
                <label>Email</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>

            <div class="text-center mt-3">
                <a href="/auth/login" class="text-decoration-none">Back to Login</a>
            </div>
        </form>
    </div>
</div>
