<!-- tag Settings Modal -->
<div id="tagModal" class="tag-modal">
    <div class="tag-modal-box">

        <div class="tag-modal-header">
            <h3>Manage Tags</h3>
            <button class="modal-close" onclick="closetagModal()">✕</button>
        </div>

        <div class="tag-modal-body">

            <table class="tag-table">
                <tbody>

                    <!-- Create -->
                    <tr class="create-tag-row">
                        <td>
                            <input type="color"
                                   class="create-tag-color"
                                   value="#6c757d" />
                        </td>

                        <td style="width: 80%">
                            <input type="text"
                                   class="create-tag-name"
                                   placeholder="New tag name" />
                        </td>

                        <td>
                            <button class="btn-create-tag">Create</button>
                        </td>
                    </tr>

                    @foreach (var c in Model.Items)
                    {
                        <tr data-tag-id="@c.Id">

                            <td>
                                <input type="color"
                                       class="tag-color-input"
                                       value="@(c.Color ?? "#adb5bd")"
                                       disabled />
                            </td>

                            <td>
                                <input type="text"
                                       class="tag-name-input"
                                       value="@c.Name"
                                       disabled />
                            </td>

                            <td>
                                <div class="row-actions">
                                    <button class="btn-edit-tag">Edit</button>
                                    <button class="btn-save-tag d-none">Save</button>
                                    <button class="btn-delete-tag">Delete</button>
                                </div>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>

        </div>

    </div>
</div>


@* template *@
<template id="tag-row-template">
    <tr>
        <td>
            <input type="color"
                   class="tag-color-input"
                   disabled />
        </td>

        <td>
            <input type="text"
                   class="tag-name-input"
                   disabled />
        </td>

        <td>

            <div class="row-actions">
                <button type="button"
                        class="btn-edit-tag">
                    Edit
                </button>

                <button type="button"
                        class="btn-save-tag d-none">
                    Save
                </button>

                <button type="button"
                        class="btn-delete-tag">
                    Delete
                </button>
            </div>


        </td>
    </tr>
</template>



<style>
    /* =========================
               tag MODAL
            ========================= */
    .tag-modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
        z-index: 9999;
    }

        .tag-modal.show {
            display: flex;
        }

    .tag-modal-box {
        width: 670px;
        max-width: 95%;
        max-height: 70vh;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
    }

    .tag-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        background: #fafafa;
        border-bottom: 1px solid #eee;
    }

        .tag-modal-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

    .tag-modal-body {
        padding: 16px;
        max-height: calc(70vh - 60px);
        overflow-y: auto;
    }

        .tag-modal-body::-webkit-scrollbar {
            width: 8px;
        }

        .tag-modal-body::-webkit-scrollbar-thumb {
            background: #d0d0d0;
            border-radius: 6px;
        }

    .modal-close {
        padding: 4px 8px;
        border: none;
        border-radius: 6px;
        background: transparent;
        font-size: 18px;
        cursor: pointer;
    }

        .modal-close:hover {
            background: #f0f0f0;
        }

    /* =========================
               tag TABLE
            ========================= */
    .tag-table {
        width: 100%;
        border-collapse: collapse;
    }

        .tag-table td {
            padding: 8px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            white-space: nowrap;
        }

        .tag-table tr:hover {
            background: #fafafa;
        }

    .create-tag-row {
        background: #fafafa;
    }

    /* =========================
               tag INPUTS
            ========================= */
    .tag-name-input,
    .create-tag-name {
        width: 100%;
        padding: 6px 8px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background: #fff;
    }

        .tag-name-input:disabled {
            background: #f9f9f9;
            color: #555;
        }

    .tag-color-input,
    .create-tag-color {
        width: 42px;
        height: 36px;
        padding: 0;
        border: 1px solid #ddd;
        border-radius: 6px;
        background: none;
        cursor: pointer;
    }

        .tag-color-input:disabled {
            cursor: not-allowed;
            opacity: 0.8;
        }

    /* =========================
               ACTION BUTTONS
            ========================= */
    .row-actions {
        display: flex;
        gap: 6px;
    }

        .row-actions button,
        .btn-create-tag {
            padding: 5px 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            background: #fff;
            font-size: 13px;
            cursor: pointer;
        }

            .row-actions button:hover,
            .btn-create-tag:hover {
                background: #f5f5f5;
            }

    .btn-save-tag {
        background: #16a34a;
        border-color: #16a34a;
    }

    .btn-delete-tag {
        border-color: #dc2626;
        color: #dc2626;
    }
</style>