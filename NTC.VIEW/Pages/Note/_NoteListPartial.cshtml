@using NTC.Contract.Repositories.Entities.Tasks
@using NTC.Core.Base

@model BasePaginatedList<NTC.ModelViews.NoteModelView.NoteResponseModelView>


@if (Model?.Items?.Any() != true)
{
    <div class="note-empty-message">No notes yet.</div>
}
else
{
    <div class="note-grid" id="noteList">
        @foreach (var note in Model.Items)
        {
            <div class="note-item"
                 data-pinned="@note.IsPinned.ToString().ToLower()">

@*                 <div class="note-card"
                     onclick="location.href='@Url.Page("Edit", new { id = note.Id })'">
 *@

                <div class="note-card"
                     data-note-id="@note.Id"
                     data-note-title="@note.Title"
                     data-note-content="@note.Content"
                     data-note-completed="@note.IsCompleted"
                     onclick="openEditNoteModal(this)">

                    <!-- BODY -->
                    <div class="note-card-body">

                        <!-- title -->
                        <div class="note-title-row">
                            <strong>@note.Title</strong>
@*                             @if (note.IsCompleted)
                            {
                                <span class="badge bg-success ms-2">Done</span>
                            } *@
                        </div>

                        <!-- Content -->
                        <div class="note-content">@note.Content</div>


                        <!-- Reminder -->
                        @if (note.Reminders.Any())
                        {
                            <div class="note-reminders">
                                @foreach (var r in note.Reminders.OrderBy(x => x.ReminderAt))
                                {
                                    <div class="note-reminder">

                                        <div class="reminder-text">
                                            <i class="bi bi-bell"></i>

                                            @r.ReminderAt.ToLocalTime().ToString("dd MMM, HH:mm")
                                        </div>
                                    </div>
                                }
                            </div>
                        }


                        <!-- Tags -->
                        @if (note.Tags.Any())
                        {
                            <div class="note-tags note-tags-bottom">
                                @foreach (var cat in note.Tags)
                                {
                                    <div class="tag-item">
                                        <span class="tag-dot"
                                              style="background:@(cat.Color ?? "#adb5bd")">
                                        </span>
                                        <span class="tag-name">@cat.Name</span>
                                    </div>
                                }
                            </div>
                        }




                    </div>




                    <!-- PIN -->
                    <div class="note-pin">
                        <button class="note-pin-btn clickable"
                                data-url="@Url.Page("Index", "TogglePin", new { id = note.Id })"
                                data-pinned="@note.IsPinned.ToString().ToLower()">
                            <i class="bi @(note.IsPinned ? "bi-pin-fill" : "bi-pin")"></i>
                        </button>
                    </div>




                    <!-- ACTIONS (3 dots) -->
                    <div class="note-actions" onclick="event.stopPropagation();">
                        <div class="dropdown">

                            <button class="note-action-btn" onclick="toggleDropdown(this)">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>


                            <div class="dropdown-menu">



                                <button class="dropdown-item"
                                        data-note-id="@note.Id"
                                        data-note-tags="@string.Join(",", note.Tags.Select(c => c.Id))"
                                        onclick="openLabelModal(this)">
                                     Tags
                                </button>


                                <button class="dropdown-item"
                                        data-note-id="@note.Id"
                                        onclick="openReminderModal(this)">
                                     Reminder
                                </button>


                                <button class="dropdown-item"
                                        onclick="deleteNote(event, '@note.Id')">
                                    Delete
                                </button>


                            </div>

                        </div>
                    </div>



                </div>
            </div>
        }
    </div>
}










