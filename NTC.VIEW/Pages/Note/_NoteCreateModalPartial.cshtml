@model NTC.ModelViews.NoteModelView.CreateNoteModelView

<div id="createNoteModal" class="note-modal">

    ```
    <div class="note-modal-box">

        <div class="note-modal-header">
            <h3>Create Note</h3>

            <button type="button"
                    class="modal-close"
                    onclick="closeCreateNoteModal()">
                ×
            </button>
        </div>

        <div class="note-modal-body">

            <form id="createNoteForm">

                <input asp-for="Title"
                       class="note-title"
                       placeholder="Title" />

                <div class="note-divider"></div>

                <textarea asp-for="Content"
                          class="note-content"
                          placeholder="Write your note..."></textarea>

                <div class="note-check-row">
                    <label>
                        <input asp-for="IsCompleted" type="checkbox" />
                        Completed
                    </label>
                </div>

                <div class="note-modal-footer">
                    <button type="button"
                            class="btn-cancel-note"
                            onclick="closeCreateNoteModal()">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn-save-note">
                        Save
                    </button>
                </div>

            </form>

        </div>

    </div>
    ```

</div>

<style>
    .note-modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,.45);
        z-index: 9999;
    }

        .note-modal.show {
            display: flex;
        }

    .note-modal-box {
        width: 700px;
        max-width: 95%;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
    }

    .note-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        background: #fafafa;
        border-bottom: 1px solid #eee;
    }

        .note-modal-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

    .modal-close {
        border: none;
        background: transparent;
        font-size: 20px;
        cursor: pointer;
    }

    .note-modal-body {
        padding: 18px;
    }

    .note-title {
        width: 100%;
        border: none;
        outline: none;
        font-size: 24px;
        font-weight: 600;
    }

    .note-divider {
        height: 1px;
        background: #eee;
        margin: 12px 0;
    }

    .note-content {
        width: 100%;
        min-height: 220px;
        border: none;
        outline: none;
        resize: vertical;
        font-size: 15px;
        line-height: 1.6;
    }

    .note-check-row {
        margin-top: 12px;
    }

    .note-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 18px;
    }

    .btn-save-note,
    .btn-cancel-note {
        padding: 6px 14px;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid #ddd;
    }

    .btn-save-note {
        background: #111827;
        color: white;
        border-color: #111827;
    }
</style>
