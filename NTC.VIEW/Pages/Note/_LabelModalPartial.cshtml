<div id="labelModal" class="modal-overlay">
    <div class="modal-box">

        <!-- HEADER -->
        <div class="modal-header">
            <h5 class="modal-title">Add labels</h5>
            <button type="button"
                    class="modal-close"
                    onclick="closeLabelModal()">
                ×
            </button>
        </div>

        <!-- BODY -->
        <div class="modal-body">
            <div class="label-container">
                @foreach (var c in Model.Items)
                {
                    <button type="button"
                            class="label-tag-btn"
                            data-tag-id="@c.Id"
                            data-tag-name="@c.Name"
                            style="background:@c.Color">
                        @c.Name
                    </button>
                }
            </div>
        </div>

        <!-- FOOTER -->
        <div class="modal-footer">
            <button type="button" id="saveLabelChangesBtn">
                Save
            </button>
        </div>

    </div>
</div>


<style>
    /* =========================
       MODAL
    ========================= */
    .modal-overlay {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
        z-index: 9999;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        width: 560px;
        max-width: 95%;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    /* =========================
       HEADER
    ========================= */
    .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        background: #fafafa;
        border-bottom: 1px solid #eee;
    }

    .modal-title {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
    }

    .modal-close {
        padding: 4px 8px;
        border: none;
        border-radius: 6px;
        background: transparent;
        font-size: 18px;
        cursor: pointer;
    }

        .modal-close:hover {
            background: #f0f0f0;
        }

    /* =========================
       BODY
    ========================= */
    .modal-body {
        padding: 16px;
        max-height: 300px;
        overflow-y: auto;
    }

        .modal-body::-webkit-scrollbar {
            width: 8px;
        }

        .modal-body::-webkit-scrollbar-thumb {
            background: #d0d0d0;
            border-radius: 6px;
        }

    /* container label */
    .label-container {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    /* =========================
       LABEL BUTTON
    ========================= */
    .label-tag-btn {
        border: none;
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 13px;
        cursor: pointer;
        color: #fff;
        opacity: 0.3;
        transition: all 0.2s ease;
    }

        .label-tag-btn:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        /* active state */
        .label-tag-btn.opacity-100 {
            opacity: 1;
            box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.12);
        }

    /* =========================
       FOOTER
    ========================= */
    .modal-footer {
        display: flex;
        justify-content: flex-end;
        padding: 14px 18px;
        border-top: 1px solid #eee;
        background: #fafafa;
    }

    #saveLabelChangesBtn {
        padding: 6px 14px;
        border: none;
        border-radius: 6px;
        background: #2563eb;
        color: #fff;
        font-size: 13px;
        cursor: pointer;
    }

        #saveLabelChangesBtn:hover {
            background: #1d4ed8;
        }
</style>

