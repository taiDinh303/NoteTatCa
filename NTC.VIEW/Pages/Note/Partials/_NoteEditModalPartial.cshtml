@model NTC.ModelViews.NoteModelView.UpdateNoteModelView

<!-- Edit Note Modal -->
<div id="editNoteModal" class="note-modal">
    <div id="editNoteBox" class="note-modal-box">
        <div class="note-modal-body">
            <form id="editNoteForm">
                <input type="hidden" asp-for="Id" id="editNoteId" />


                <div class="edit-note-scroll">
                    <div class="edit-note-header">
                        <input asp-for="Title" id="editNoteTitle" class="edit-note-title" placeholder="Title" />

                        <div class="edit-note-header-actions">
                            <button type="button" id="editPinBtn" class="edit-note-pin-btn" data-pinned="false" onclick="toggleEditPin(this)">
                                <i class="bi bi-pin"></i>
                            </button>

                            <button type="button" class="edit-note-pin-btn" onclick="toggleEditNoteFullscreen()">
                                <i class="bi bi-arrows-fullscreen"></i>
                            </button>
                        </div>
                    </div>

                    <textarea asp-for="Content" id="editNoteContent" class="edit-note-content" placeholder="Write your note..."></textarea>

                    <div id="editNoteTags" class="edit-note-tags"></div>

                </div>



                <div class="note-modal-footer">
                    <div class="note-footer-actions">


                        <div class="note-color-picker">
                            <button type="button" class="btn-note-color" title="Change color" onclick="document.getElementById('editNoteColor').click()">
                                <i class="bi bi-palette"></i>
                            </button>
                            <input type="color" id="editNoteColor" class="edit-note-color-input" onchange="changeNoteColor(this.value)" />
                        </div>

                        <button type="button" class="btn-note-color" title="Tags" data-action="label-note" data-note-id="" data-note-tags=""><i class="bi bi-tags"></i></button>
                        <button type="button" class="btn-note-color" title="Move to trash" data-action="move-to-trash" data-note-id=""><i class="bi bi-trash"></i></button>

                    </div>

                    <button type="button" class="btn-cancel-note" onclick="closeEditNoteModal()">Cancel</button>
                </div>
            </form>
        </div>

    </div>
</div>

<!-- Template -->
<template id="edit-note-template">
    <input type="hidden" class="note-id" />

    <input type="text" class="note-title" placeholder="Title" />

    <textarea class="note-content" placeholder="Write your note..."></textarea>
</template>


<style>
    #editNoteModal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,.45);
        z-index: 9999;
    }

        #editNoteModal.show {
            display: flex;
        }

        #editNoteModal .note-modal-box {
            display: flex;
            flex-direction: column;
            width: 50%;
            max-height: 90vh;
            min-height: 0;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
        }

            #editNoteModal .note-modal-box.fullscreen {
                width: 100vw;
                height: 100vh;
                max-width: none;
                max-height: none;
                border-radius: 0;
            }

        #editNoteModal .note-modal-body {
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
        }

        #editNoteModal #editNoteForm {
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
        }

        #editNoteModal .edit-note-title {
            width: 100%;
            flex: 1;
            margin-bottom: 0;
            border: none;
            outline: none;
            background: transparent;
            font-size: 1.25rem;
            font-weight: 600;
            color: #212529;
            padding: 0;
        }

        #editNoteModal .edit-note-header {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        #editNoteModal .edit-note-header-actions {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-shrink: 0;
        }

        #editNoteModal .edit-note-pin-btn {
            width: 38px;
            height: 38px;
            border: none;
            border-radius: 50%;
            background: transparent;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: #5f6368;
            transition: background-color .2s;
        }

            #editNoteModal .edit-note-pin-btn:hover {
                background: rgba(0,0,0,.08);
            }

            #editNoteModal .edit-note-pin-btn.pinned i {
                color: #1a73e8;
            }

        #editNoteModal .edit-note-content {
            display: block;
            width: 100%;
            min-height: 100px;
            height: auto;
            margin-top: 16px;
            padding: 0;
            border: none;
            outline: none;
            background: transparent;
            resize: none;
            overflow: hidden;
            font-size: .95rem;
            line-height: 1.6;
            color: #495057;
        }

        #editNoteModal .edit-note-tags {
            display: flex;
            flex-wrap: wrap;
            column-gap: 6px;
            row-gap: 6px;
            margin-top: 8px;
            padding-bottom: 8px;
        }

        #editNoteModal .note-modal-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex: 0 0 auto;
            min-height: 54px;
            padding: 0 18px 0 6px;
        }

        #editNoteModal .note-footer-actions {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        #editNoteModal .btn-note-color {
            width: 38px;
            height: 38px;
            border: none;
            border-radius: 50%;
            background: transparent;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: #5f6368;
            transition: background-color .2s;
        }

            #editNoteModal .btn-note-color:hover,
            #editNoteModal .note-color-picker:hover .btn-note-color {
                background: rgba(0,0,0,.08);
            }

        #editNoteModal .note-color-picker {
            position: relative;
            display: inline-flex;
            width: 38px;
            height: 38px;
        }

        #editNoteModal .edit-note-color-input {
            position: absolute;
            inset: 0;
            opacity: 0;
            pointer-events: none;
            cursor: pointer;
        }

        #editNoteModal .btn-cancel-note {
            padding: 6px 14px;
            border-radius: 6px;
            cursor: pointer;
            border: 1px solid #ddd;
            background: #fff;
            color: #212529;
        }

        #editNoteModal .edit-note-scroll {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 16px 8px 0 16px;

            scrollbar-width: thin;
            scrollbar-color: rgba(0,0,0,.15) transparent;
        }

            #editNoteModal .edit-note-scroll::-webkit-scrollbar {
                width: 6px;
            }

            #editNoteModal .edit-note-scroll::-webkit-scrollbar-track {
                background: transparent;
            }

            #editNoteModal .edit-note-scroll::-webkit-scrollbar-thumb {
                background: rgba(0,0,0,.15);
                border-radius: 10px;
            }

                #editNoteModal .edit-note-scroll::-webkit-scrollbar-thumb:hover {
                    background: rgba(0,0,0,.25);
                }


</style>