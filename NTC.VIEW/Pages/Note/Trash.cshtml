@page
@model NTC.Razor.Pages.Note.TrashModel
@{
    ViewData["Title"] = "Trash";

    if (HttpContext.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
        Layout = null;
    else
        Layout = "/Pages/Shared/_NoteLayout.cshtml";
}

<div id="noteListWrapper">
    <partial name="~/Pages/Note/Partials/_NoteTrashListPartial.cshtml"
             model="Model.Notes" />
</div>


<form method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>