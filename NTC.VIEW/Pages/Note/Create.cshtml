@page
@model NTC.Razor.Pages.Note.CreateModel
@{
    ViewData["Title"] = "Create Note";
}

<div class="container py-4">

    <form method="post">

        <!-- Paper -->
        <div class="note-paper mb-3">

            <!-- Title -->
            <input asp-for="Note.Title"
                   class="note-title"
                   placeholder="Title" />

            <!-- Divider -->
            <div class="note-divider"></div>

            <!-- Content -->
            <textarea asp-for="Note.Content"
                      class="note-content auto-resize"
                      placeholder="Write your note..."></textarea>

        </div>

        <div class="form-check mb-3">
            <input asp-for="Note.IsCompleted" class="form-check-input" />
            <label class="form-check-label">Completed</label>
        </div>

        <button class="btn btn-primary w-100">Save</button>
        <a asp-page="Index" class="btn btn-secondary w-100 mt-2">Cancel</a>

    </form>
</div>


@section Styles {
    <link rel="stylesheet" href="~/css/note/edit.css" asp-append-version="true" />
}



<script>
    function autoResize(textarea) {
        textarea.style.height = 'auto';
        textarea.style.height = textarea.scrollHeight + 'px';
    }

    document.querySelectorAll('textarea.auto-resize')
        .forEach(textarea => {
            autoResize(textarea); // khi load (edit case)

            textarea.addEventListener('input', () => {
                autoResize(textarea);
            });
        });
</script>
