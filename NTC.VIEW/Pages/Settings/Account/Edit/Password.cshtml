@page
@model NTC.Razor.Pages.Settings.Account.Edit.PasswordModel

@{
    ViewData["Title"] = "Password";
}

<div class="settings-page">

    <div class="settings-card">

        <div class="settings-card-header">
            Password
        </div>

        <div class="settings-card-body">

            @if (ViewData["SuccessMessage"] != null)
            {
                <div class="settings-alert settings-alert-success">
                    @ViewData["SuccessMessage"]
                </div>
            }

            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="settings-alert settings-alert-danger">
                    @ViewData["ErrorMessage"]
                </div>
            }

            <form method="post">

                <!-- Current Password -->

                <div class="password-group">
                    <label asp-for="CurrentPassword"
                           class="settings-label">
                        Current Password
                    </label>

                    <div class="password-wrapper">

                        <input asp-for="CurrentPassword"
                               id="currentPassword"
                               type="password"
                               class="settings-input"
                               required />

                        <button type="button"
                                class="password-toggle pw-toggle"
                                data-target="currentPassword">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>
                </div>

                <!-- New Password -->

                <div class="password-group">
                    <label asp-for="NewPassword"
                           class="settings-label">
                        New Password
                    </label>

                    <div class="password-wrapper">

                        <input asp-for="NewPassword"
                               id="newPassword"
                               type="password"
                               class="settings-input"
                               required />

                        <button type="button"
                                class="password-toggle pw-toggle"
                                data-target="newPassword">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Confirm Password -->

                <div class="password-group">


                    <label asp-for="ConfirmPassword"
                           class="settings-label">
                        Confirm Password
                    </label>

                    <div class="password-wrapper">

                        <input asp-for="ConfirmPassword"
                               id="confirmPassword"
                               type="password"
                               class="settings-input"
                               required />

                        <button type="button"
                                class="password-toggle pw-toggle"
                                data-target="confirmPassword">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                </div>


                <button type="submit"
                        class="settings-btn settings-btn-submit">
                    Change Password
                </button>

                <a href="/settings/account"
                   class="settings-btn settings-btn-cancel">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        document.querySelectorAll(".pw-toggle").forEach(btn => {

            btn.addEventListener("click", () => {

                const input =
                    document.getElementById(btn.dataset.target);

                const isPassword =
                    input.type === "password";

                input.type =
                    isPassword ? "text" : "password";

                btn.innerHTML =
                    isPassword
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';
            });

        });
    </script>

}

@section Styles {

    <link rel="stylesheet"
          href="~/css/setting_edit.css"
          asp-append-version="true" />

}