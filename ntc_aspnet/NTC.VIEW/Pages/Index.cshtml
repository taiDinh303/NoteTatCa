@page
@model IndexModel
@{
    ViewData["Title"] = "Home";

    if (HttpContext.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
}

<style>
    /* =========================
           GLOBAL
        ========================= */

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        background: #f6f8fc;
        color: #1f2937;
    }

    a {
        text-decoration: none;
    }

    .container {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
    }


    /* =========================
           HERO
        ========================= */

    .hero {
        position: relative;
        overflow: hidden;
        padding: 90px 20px 110px;
        text-align: center;
        color: white;
        background: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.18), transparent 25%), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.14), transparent 25%), linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border-radius: 0 0 45px 45px;
    }

        .hero::before,
        .hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            pointer-events: none;
        }

        .hero::before {
            width: 280px;
            height: 280px;
            top: -140px;
            left: -80px;
        }

        .hero::after {
            width: 360px;
            height: 360px;
            right: -130px;
            bottom: -200px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 760px;
        margin: 0 auto;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        margin-bottom: 22px;
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 999px;
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(10px);
        font-size: 14px;
        font-weight: 600;
    }

    .hero h1 {
        margin: 0 0 20px;
        font-size: clamp(42px, 7vw, 72px);
        line-height: 1.05;
        letter-spacing: -2px;
        font-weight: 800;
    }

        .hero h1 span {
            background: linear-gradient(90deg, #ffffff, #dce7ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero p {
        max-width: 650px;
        margin: 0 auto 32px;
        color: rgba(255,255,255,0.88);
        font-size: 19px;
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 145px;
        padding: 13px 24px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 700;
        transition: all 0.25s ease;
    }

    .btn-primary {
        color: #2575fc;
        background: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }

    .btn-outline {
        color: white;
        border: 1px solid rgba(255,255,255,0.35);
        background: rgba(255,255,255,0.08);
    }

        .btn-outline:hover {
            background: rgba(255,255,255,0.16);
            transform: translateY(-3px);
        }


    /* =========================
           SECTION HEADER
        ========================= */

    .section-header {
        max-width: 650px;
        margin: 80px auto 35px;
        text-align: center;
    }

        .section-header .label {
            display: inline-block;
            margin-bottom: 10px;
            color: #5f27cd;
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .section-header h2 {
            margin: 0 0 12px;
            color: #111827;
            font-size: 34px;
            line-height: 1.2;
        }

        .section-header p {
            margin: 0;
            color: #6b7280;
            font-size: 16px;
            line-height: 1.7;
        }


    /* =========================
           CAROUSEL
        ========================= */

    .carousel {
        position: relative;
        width: min(1000px, calc(100% - 40px));
        margin: 45px auto 80px;
        overflow: hidden;
        border-radius: 24px;
        background: #111827;
        box-shadow: 0 20px 50px rgba(31, 41, 55, 0.18);
    }

    .carousel-track {
        display: flex;
        width: 300%;
        animation: slide 12s infinite;
    }

    .slide {
        position: relative;
        width: 33.333333%;
        height: 400px;
        flex-shrink: 0;
        overflow: hidden;
    }

        .slide img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .slide::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( to top, rgba(0,0,0,0.65), rgba(0,0,0,0.05) 65% );
        }

    .slide-content {
        position: absolute;
        z-index: 2;
        left: 40px;
        right: 40px;
        bottom: 35px;
        color: white;
    }

        .slide-content h3 {
            margin: 0 0 8px;
            font-size: 30px;
        }

        .slide-content p {
            margin: 0;
            max-width: 500px;
            color: rgba(255,255,255,0.85);
            line-height: 1.6;
        }

    .carousel:hover .slide img {
        transform: scale(1.03);
    }

    @@keyframes slide {
        0% {
            transform: translateX(0);
        }

        28% {
            transform: translateX(0);
        }

        33% {
            transform: translateX(-33.333333%);
        }

        61% {
            transform: translateX(-33.333333%);
        }

        66% {
            transform: translateX(-66.666666%);
        }

        94% {
            transform: translateX(-66.666666%);
        }

        100% {
            transform: translateX(0);
        }
    }


    /* =========================
           FEATURES
        ========================= */

    .features {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 22px;
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto 90px;
    }

    .card-box {
        position: relative;
        padding: 28px;
        overflow: hidden;
        border: 1px solid #e8ecf4;
        border-radius: 20px;
        background: white;
        box-shadow: 0 8px 25px rgba(31, 41, 55, 0.05);
        transition: all 0.3s ease;
    }

        .card-box::before {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            top: -50px;
            right: -50px;
            border-radius: 50%;
            background: #f0ebff;
            transition: transform 0.3s ease;
        }

        .card-box:hover {
            transform: translateY(-8px);
            border-color: #ddd6fe;
            box-shadow: 0 18px 40px rgba(31, 41, 55, 0.10);
        }

            .card-box:hover::before {
                transform: scale(1.5);
            }

    .icon {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        margin-bottom: 22px;
        border-radius: 15px;
        background: linear-gradient(135deg, #ede9fe, #dbeafe);
        color: #5f27cd;
        font-size: 24px;
    }

    .card-box h3 {
        position: relative;
        z-index: 1;
        margin: 0 0 10px;
        color: #111827;
        font-size: 19px;
    }

    .card-box p {
        position: relative;
        z-index: 1;
        margin: 0;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.7;
    }


    /* =========================
           INFO SECTION
        ========================= */

    .info-section {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto 100px;
        padding: 55px;
        border-radius: 28px;
        background: #111827;
        color: white;
        overflow: hidden;
        position: relative;
    }

        .info-section::after {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            right: -100px;
            top: -130px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.25);
        }

    .info-content {
        position: relative;
        z-index: 2;
        max-width: 700px;
    }

        .info-content h2 {
            margin: 0 0 15px;
            font-size: 34px;
        }

        .info-content p {
            margin: 0;
            color: #cbd5e1;
            line-height: 1.8;
            font-size: 16px;
        }


    /* =========================
           FOOTER
        ========================= */

    .footer {
        padding: 55px 20px 25px;
        background: #0f172a;
        color: white;
    }

    .footer-container {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
    }

    .footer-main {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 50px;
        padding-bottom: 45px;
    }

    .footer-brand h2 {
        margin: 0 0 12px;
        font-size: 24px;
    }

    .footer-brand p {
        max-width: 330px;
        margin: 0;
        color: #94a3b8;
        line-height: 1.7;
        font-size: 14px;
    }

    .footer-column h4 {
        margin: 0 0 18px;
        font-size: 15px;
    }

    .footer-column a {
        display: block;
        margin-bottom: 11px;
        color: #94a3b8;
        font-size: 14px;
        transition: color 0.2s ease;
    }

        .footer-column a:hover {
            color: white;
        }

    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-top: 22px;
        border-top: 1px solid #1e293b;
        color: #64748b;
        font-size: 13px;
    }

    .footer-social {
        display: flex;
        gap: 10px;
    }

    .social {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #1e293b;
        color: #cbd5e1;
        transition: all 0.2s ease;
    }

        .social:hover {
            background: #334155;
            color: white;
            transform: translateY(-2px);
        }


    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 900px) {
        .features {
            grid-template-columns: repeat(2, 1fr);
        }

        .footer-main {
            grid-template-columns: 2fr 1fr 1fr;
        }

        .footer-brand {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 600px) {
        .hero {
            padding: 70px 20px 90px;
            border-radius: 0 0 30px 30px;
        }

            .hero h1 {
                font-size: 44px;
            }

            .hero p {
                font-size: 16px;
            }

        .carousel {
            width: calc(100% - 30px);
            border-radius: 18px;
        }

        .slide {
            height: 300px;
        }

        .slide-content {
            left: 25px;
            right: 25px;
            bottom: 25px;
        }

            .slide-content h3 {
                font-size: 24px;
            }

        .features {
            grid-template-columns: 1fr;
            width: calc(100% - 30px);
        }

        .info-section {
            width: calc(100% - 30px);
            padding: 35px 25px;
        }

        .info-content h2 {
            font-size: 28px;
        }

        .footer-main {
            grid-template-columns: 1fr 1fr;
            gap: 35px;
        }

        .footer-brand {
            grid-column: 1 / -1;
        }

        .footer-bottom {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>


