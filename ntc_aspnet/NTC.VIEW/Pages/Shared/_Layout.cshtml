<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Layout</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/header.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


    @RenderSection("Styles", required: false)
</head>




<!-- Check Authentica -->
@{
    var isLogin = Context.Session.GetString("UserId") != null;
}


<body>
    <header class="site-header">

        <partial name="_Topbar" />

    </header>


    <main role="main" class="page-layout">

        @*         <partial name="_Sidebar" /> *@

        <main class="page-content">
            @RenderBody()
        </main>

    </main>


    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script src="https://unpkg.com/imagesloaded@4/imagesloaded.pkgd.min.js"></script>

    <script src="~/js/note/tag.js" asp-append-version="true"></script>
    <script src="~/js/note/label.js" asp-append-version="true"></script>
    <script src="~/js/note/note.js" asp-append-version="true"></script>
    <script src="~/js/note/reminder.js" asp-append-version="true"></script>




    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>