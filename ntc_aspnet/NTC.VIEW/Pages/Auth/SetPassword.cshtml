@page "/auth/set-password"
@model NTC.Razor.Pages.Auth.SetPasswordModel
@{
    ViewData["Title"] = "Create New Password";
    Layout = "_AuthLayout";
}

<div class="login-register-page">

    <div class="login-card">

        <h2 class="login-title">Create New Password</h2>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        @if (Model.SuccessMessage != null)
        {
            <div class="alert-success">@Model.SuccessMessage</div>
        }

        <form method="post">

            <div class="form-group password-group">
                <label for="NewPassword">New Password</label>

                <div class="password-wrapper">
                    <input asp-for="NewPassword" type="password" id="NewPassword" required />

                    <button type="button" onclick="togglePassword('NewPassword', this)" class="password-toggle" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="form-group password-group">
                <label for="ConfirmPassword">Confirm Password</label>

                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword" required />

                    <button type="button" onclick="togglePassword('ConfirmPassword', this)" class="password-toggle" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-primary">
                Create Password
            </button>

            <div class="register-link">
                <a href="/auth/login">
                    Back to <strong>Login</strong>
                </a>
            </div>

        </form>

    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}