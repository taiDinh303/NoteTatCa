@page
@model NTC.Razor.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

<div class="login-register-page">

    <div class="login-card">

        <h2 class="login-title">Register</h2>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert-success">@Model.SuccessMessage</div>
        }

        <!-- STEP 1 -->
        <div id="formStep1">

            <div class="form-group">
                <label>Username</label>
                <input id="usernameInput" required />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input id="emailInput" type="email" required />
            </div>

            <div class="form-group">
                <label>Password</label>


                <div class="password-wrapper">
                    <input id="passwordInput" type="password" required />

                    <button type="button"
                            onclick="togglePassword('passwordInput', this)"
                            class="password-toggle">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>





            </div>

            <div class="form-group">
                <label>Confirm Password</label>

                <div class="password-wrapper">
                    <input id="confirmPasswordInput" type="password" required />

                    <button type="button"
                            onclick="togglePassword('confirmPasswordInput', this)"
                            class="password-toggle">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <button type="button" class="btn-primary" onclick="continueStep()">
                Continue
            </button>

        </div>


        <!-- STEP 2 -->
        <div id="formStep2" style="display:none;">

            <h4 id="verifyTitle" style="text-align:center;margin-bottom:20px;"></h4>

            <form method="post" asp-page-handler="Submit">

                <input type="hidden" name="Input.Username" id="hUsername" />
                <input type="hidden" name="Input.Email" id="hEmail" />
                <input type="hidden" name="Input.Password" id="hPassword" />
                <input type="hidden" name="Input.ConfirmPassword" id="hConfirmPassword" />

                <div class="form-group">
                    <label>Verification Code</label>
                    <input name="Input.ConfirmationCode" id="codeInput" required />
                </div>

                <button type="submit" class="btn-primary">
                    Submit
                </button>

            </form>

            <button class="btn-secondary" onclick="goBack()">
                Back
            </button>

        </div>

        <div class="register-link">
            <a href="/auth/login">
                Already have an account? <strong>Login</strong>
            </a>
        </div>

    </div>

</div>



@section Scripts {
    <script>
        async function continueStep(){

            const username = document.getElementById("usernameInput");
            const email = document.getElementById("emailInput");
            const password = document.getElementById("passwordInput");
            const confirmPassword = document.getElementById("confirmPasswordInput");

            if(!username.reportValidity() ||
               !email.reportValidity() ||
               !password.reportValidity() ||
               !confirmPassword.reportValidity()){
                return;
            }

            const api = "https://localhost:5033/api/auth/send-email-confirmation";

            const response = await fetch(api,{
                method:"POST",
                headers:{"Content-Type":"application/json"},
                body:JSON.stringify(email.value)
            });

            if(!response.ok){
                alert("Error sending confirmation email");
                return;
            }

            alert("Confirmation code sent to your email!");

            document.getElementById("hUsername").value = username.value;
            document.getElementById("hEmail").value = email.value;
            document.getElementById("hPassword").value = password.value;
            document.getElementById("hConfirmPassword").value = confirmPassword.value;

            document.getElementById("formStep1").style.display="none";
            document.getElementById("formStep2").style.display="block";

            document.getElementById("verifyTitle").innerText =
                `Enter the 6-digit code we sent to "${email.value}"`;

        }

        function goBack(){
            document.getElementById("formStep1").style.display="block";
            document.getElementById("formStep2").style.display="none";
        }

    </script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}