@page
@model NTC.Razor.Pages.Note.IndexModel
@{
    ViewData["Title"] = "Notes";

    // nếu request là ajax thì bỏ layout
    if (HttpContext.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
    {
        Layout = null;
    }
    else
    {
        Layout = "/Pages/Shared/_NoteLayout.cshtml";
    }
}



<!-- Main note-->
<div id="noteListWrapper">
    <partial name="~/Pages/Note/Partials/_NoteListPartial.cshtml"
             model="Model.Notes" />
</div>






<form method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>




<!-- Modal -->
<div>
    <partial name="~/Pages/Note/Partials/_TagModalPartial.cshtml"
             model="Model.Tags" />

    <partial name="~/Pages/Note/Partials/_NoteTagsModalPartial.cshtml"
             model="Model.Tags" />

    <partial name="~/Pages/Note/Partials/_ReminderModalPartial.cshtml" />

    <partial name="~/Pages/Note/Partials/_NoteCreateModalPartial.cshtml"
             model="new NTC.ModelViews.NoteModelView.CreateNoteModelView()" />

    <partial name="~/Pages/Note/Partials/_NoteEditModalPartial.cshtml"
             model="new NTC.ModelViews.NoteModelView.UpdateNoteModelView()" />
</div>