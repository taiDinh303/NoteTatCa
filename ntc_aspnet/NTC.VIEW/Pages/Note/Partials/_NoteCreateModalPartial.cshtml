@model NTC.ModelViews.NoteModelView.CreateNoteModelView

<div id="createNoteModal" class="note-modal">
    <div class="note-modal-box">
        <div class="note-modal-body">
            <form id="createNoteForm">
                <input asp-for="Title" class="note-title" placeholder="Title" />

                <div class="note-divider"></div>

                <textarea asp-for="Content" class="create-note-content" placeholder="Write your note..."></textarea>

                <div class="note-modal-footer">
                    <button type="submit" class="btn-save-note">Save</button>
                    <button type="button" class="btn-cancel-note" onclick="closeCreateNoteModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<template id="note-template">
    <div class="note-item">
        <div class="note-card">

            <div class="note-card-body">
                <!-- title -->
                <div class="note-title-row"><strong></strong></div>
                <!-- Content -->
                <div class="note-content"></div>

                <div class="note-tags note-tags-bottom d-none"></div>

            </div>
            <!-- PIN -->
            <div class="note-pin">
                <button class="note-pin-btn clickable">
                    <i class="bi bi-pin"></i>
                </button>
            </div>

            <!-- ACTIONS (3 dots) -->
            <div class="note-actions">
                <div class="dropdown">
                    <button class="note-action-btn"data-action="toggle-dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                    <div class="dropdown-menu">
                        <button class="dropdown-item"data-action="label-note">Tags</button>
                        <button class="dropdown-item"data-action="delete-note">Delete </button>
                    </div>
                </div>

            </div>

        </div>
    </div>
</template>





<style>
    #createNoteModal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,.45);
        z-index: 9999;
    }

        #createNoteModal.show {
            display: flex;
        }

        #createNoteModal .note-modal-box {
            width: 700px;
            max-width: 95%;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
        }

        #createNoteModal .modal-close {
            border: none;
            background: transparent;
            font-size: 20px;
            cursor: pointer;
        }

        #createNoteModal .note-modal-body {
            padding: 18px;
        }

        #createNoteModal .note-title {
            width: 100%;
            border: none;
            outline: none;
            font-size: 24px;
            font-weight: 600;
        }

        #createNoteModal .note-divider {
            height: 1px;
            background: #eee;
            margin: 12px 0;
        }

        #createNoteModal .create-note-content {
            width: 100%;
            min-height: 220px;
            border: none;
            outline: none;
            resize: vertical;
            font-size: 15px;
            line-height: 1.6;
            resize: none;
        }

        #createNoteModal .note-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 18px;
        }

        #createNoteModal .btn-save-note,
        #createNoteModal .btn-cancel-note {
            padding: 6px 14px;
            border-radius: 6px;
            cursor: pointer;
            border: 1px solid #ddd;
        }

        #createNoteModal .btn-save-note {
            background: #111827;
            color: white;
            border-color: #111827;
        }
</style>
