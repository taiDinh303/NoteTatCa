@{
    var isLogin = Context.Session.GetString("UserId") != null;
}

@if (isLogin)
{
    <div id="sidebar" class="sidebar">
        <div class="sidebar-content">

            <div class="sidebar-menu">
                <a href="/Note" data-spa>Notes</a>
                <a class="sidebar-create-btn clickable" data-action="create-note">New note</a>
            </div>

            <div id="tagBar" class="note-tag-row">
                <a id="editTagsBtn" class="clickable" data-action="edit-tags">Edit tags</a>

                @foreach (var c in Model.Tags!.Items)
                {
                    <button class="tag-btn" data-tag-id="@c.Id">
                        <span class="tag-name">@c.Name</span>
                        <span class="tag-dot" style="background:@(c.Color ?? "#adb5bd")"></span>
                    </button>
                }
            </div>

            <div class="sidebar-menu">
                <a href="/Note/Trash" data-spa>Trash</a>
            </div>

        </div>
    </div>


}

