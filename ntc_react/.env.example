# Copy to .env.local for Development. VITE_* values are public browser config.
VITE_API_BASE_URL=/api/v1
# Dev-server only; this key does not enter browser assets.
API_PROXY_TARGET=http://localhost:5032
# Vercel Production: use the absolute HTTPS API URL from ../deploy/project.json.
# Do not reuse the Production API in isolated tests/Preview.
VITE_GOOGLE_CLIENT_ID=
